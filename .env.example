# KRISHIPULSE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your credentials.

# 1. Supabase PostgreSQL & Realtime (Free Tier at https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Google Gemini 1.5 Flash AI Key (Free at https://aistudio.google.com)
# Used for Pulse AI conversational agronomist and PulseVision crop disease multimodal diagnosis.
# (If omitted, KrishiPulse gracefully defaults to domain-expert local agricultural engines)
GEMINI_API_KEY=your-google-gemini-api-key

# 3. IoT Hardware Ingestion Token (ESP32 Microcontroller Authentication)
# Sent in HTTP Header "X-Device-Token" when ESP32 posts to /api/sensors/readings
ESP32_API_SECRET=krishipulse-esp32-secret-2026

# 4. Backend Express Server Port
PORT=5000
